# Copy to backend/.env and fill in. Never commit the real file.

# LLM provider: "anthropic" (default) or "offline" (deterministic rule-based demo planner, no LLM).
# If LLM_PROVIDER=anthropic and no key is set, the app falls back to "offline" and says so in the UI.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (higher = more thorough, slower, more tokens)
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=60

# Data (defaults shown). SOURCE_EXCEL_PATH is only used by scripts/prepare_data.py.
# SOURCE_EXCEL_PATH=../online+retail+ii/online_retail_II.xlsx
# DATA_DIR=./data

# Query safety
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
MAX_QUESTION_LENGTH=500

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
